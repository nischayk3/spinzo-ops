{
  "expo": {
    "name": "SpinZo Ops",
    "slug": "spinzo-ops",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#E6F4FE"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nischayk3.spinzo-ops"
    },
    "android": {
      "newArchEnabled": true,
      "package": "com.nischayk3.spinzoops",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.INTERNET",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.WAKE_LOCK",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.VIBRATE"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "icon": "./assets/icon.png",
      "backgroundColor": "#E6F4FE",
      "themeColor": "#3b82f6",
      "description": "SpinZo Operations Management"
    },
    "plugins": [
      "expo-status-bar",
      "./plugins/withGradleJvmArgs",
      [
        "expo-build-properties",
        {
          "android": {
            "usesNonExemptEncryption": false
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "SpinZo Ops needs camera access for QR scanning and photo verification."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "SpinZo Ops uses your location for geo-fenced shift verification."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SpinZo Ops uses your photos for order verification."
        }
      ],
      "expo-audio",
      "@react-native-firebase/app",
      "@react-native-firebase/auth"
    ],
    "extra": {
      "eas": {
        "projectId": "19adb8df-64bc-4ee5-8abf-c24aa1d4f7dc"
      }
    },
    "owner": "nischayk3",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/19adb8df-64bc-4ee5-8abf-c24aa1d4f7dc"
    }
  }
}
